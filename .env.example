# Copy to .env.local and fill in to switch the app from mock data to a real Supabase
# backend. Leave unset (or absent) to run in mock mode — the app still works fully.
#
# Local dev (supabase start prints these):
#   VITE_SUPABASE_URL=http://localhost:54321
#   VITE_SUPABASE_ANON_KEY=<anon key from `supabase start` output>
#
# Hosted project (Project Settings → API):
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon public key>

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
